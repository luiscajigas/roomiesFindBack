<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.roomiesfind</groupId>
  <artifactId>roomiesfind</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>RoomiesFind - monorepositorio de microservicios</name>

  <modules>
    <module>contratos</module>
    <module>comun</module>
    <module>servicios/usuarios</module>
    <module>servicios/perfiles</module>
    <module>servicios/compatibilidad</module>
    <module>servicios/ia</module>
    <module>servicios/chat</module>
    <module>infraestructura</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <grpc.version>1.85.1</grpc.version>
    <protobuf.version>4.36.2</protobuf.version>
    <java-jwt.version>4.6.2</java-jwt.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-bom</artifactId>
        <version>${grpc.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java</artifactId>
        <version>${protobuf.version}</version>
      </dependency>
      <dependency>
        <groupId>com.roomiesfind</groupId>
        <artifactId>contratos</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.roomiesfind</groupId>
        <artifactId>comun</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
